# Copiar a .env.local para desarrollo. Nunca subir el archivo con valores reales.

# Postgres de Neon, con SSL. Se saca del panel del proyecto.
DATABASE_URL="postgresql://usuario:clave@host.neon.tech/gymbro?sslmode=require"

# Secreto del servidor para firmar los códigos de verificación y derivar claves.
# Generarlo con: openssl rand -base64 32
AUTH_SECRET=""

# Envío de correo (Resend). El remitente debe estar en un dominio verificado.
RESEND_API_KEY=""
CORREO_REMITENTE="Gym Bro <acceso@tudominio.com>"

# URL pública de la app, para los enlaces de los correos.
URL_PUBLICA="https://gym-bro.vercel.app"
