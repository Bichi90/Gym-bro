# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore: nunca subas claves reales al repositorio.
# Los pasos para conseguir cada valor están en docs/configuracion.md.

# Postgres de Neon. La cadena "pooled" del panel del proyecto.
# En producción debe incluir sslmode=require.
# Preview tiene que apuntar a una RAMA DISTINTA, nunca a la base de producción.
DATABASE_URL="postgresql://usuario:clave@host.neon.tech/gymbro?sslmode=require"

# Secreto del servidor: firma los códigos de verificación y las sesiones.
# Uno distinto por entorno. Generalo con: openssl rand -base64 32
AUTH_SECRET=""

# Envío de correo (Resend).
# Con el remitente de pruebas onboarding@resend.dev solo llegan correos a la
# dirección con la que se creó la cuenta de Resend. Para escribirle a otra
# gente hace falta un dominio verificado. Ver docs/configuracion.md.
RESEND_API_KEY=""
CORREO_REMITENTE="Gym Bro <onboarding@resend.dev>"

# URL pública del entorno, para los enlaces de los correos.
# Producción: https://gymbro-ar.vercel.app · Local: http://localhost:3000
URL_PUBLICA="https://gymbro-ar.vercel.app"
